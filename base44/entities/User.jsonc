{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "phone": {
      "type": "string",
      "description": "User phone number for orders"
    },
    "address": {
      "type": "string",
      "description": "User delivery address for orders"
    }
  },
  "required": [
    "role"
  ]
}