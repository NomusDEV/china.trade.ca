{
  "name": "Order",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "name_ru": {
            "type": "string"
          },
          "name_tj": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "image": {
            "type": "string"
          }
        }
      },
      "description": "Order items"
    },
    "total": {
      "type": "number",
      "description": "Total order amount in USD"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name"
    },
    "customer_phone": {
      "type": "string",
      "description": "Customer phone"
    },
    "customer_address": {
      "type": "string",
      "description": "Delivery address"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "shipped",
        "delivered",
        "cancelled"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string",
      "description": "Order notes"
    }
  },
  "required": [
    "customer_name",
    "customer_phone",
    "total"
  ]
}